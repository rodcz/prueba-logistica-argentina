# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO: PRUEBA LOGÍSTICA ARGENTINA
# ==============================================================================
# Copie este archivo como .env y complete los valores antes de iniciar los contenedores.
# El archivo .env contiene credenciales sensibles y NO debe versionarse en Git.

# --- Configuración de PostgreSQL 18 Data Warehouse ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=warehouse_db
POSTGRES_PORT=5432
AIRFLOW_DB=airflow_db

# --- Configuración de Apache Airflow 2.10 LTS ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__WEBSERVER__SECRET_KEY=4686e72d308382022752daea2e39d732

# --- Configuración de dbt Core ---
DBT_PROFILES_DIR=/opt/dbt
